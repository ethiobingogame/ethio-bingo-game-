<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>አራዳ ቢንጎ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body class="bg-indigo-950 text-white font-sans">

    <div class="max-w-md mx-auto p-4 min-h-screen flex flex-col justify-between">
        <!-- Header -->
        <div class="flex justify-between items-center bg-indigo-900 p-3 rounded-xl shadow-lg">
            <span class="text-yellow-400 font-bold text-lg">💰 27 ETB</span>
            <span class="font-extrabold tracking-wider text-xl">አራዳ ቢንጎ</span>
            <button class="bg-blue-600 px-3 py-1 rounded-lg text-sm">Refresh</button>
        </div>

        <!-- Stake Selection Screen -->
        <div id="stake-screen" class="my-auto space-y-4">
            <h2 class="text-center text-xl font-bold mb-4">የውርርድ መጠን ይምረጡ (Stake)</h2>
            
            <div onclick="selectStake(10)" class="bg-indigo-900 hover:bg-indigo-800 p-4 rounded-xl flex justify-between items-center cursor-pointer border border-indigo-700">
                <div>
                    <span class="text-xl font-bold text-yellow-400">10 ETB</span>
                    <p class="text-xs text-gray-400">ተጫዋቾች: 78 | ገንዳ: 640 ETB</p>
                </div>
                <button class="bg-yellow-500 text-black font-bold px-5 py-2 rounded-lg">Play</button>
            </div>

            <div onclick="selectStake(20)" class="bg-indigo-900 hover:bg-indigo-800 p-4 rounded-xl flex justify-between items-center cursor-pointer border border-indigo-700">
                <div>
                    <span class="text-xl font-bold text-yellow-400">20 ETB</span>
                    <p class="text-xs text-gray-400">ተጫዋቾች: 82 | ገንዳ: 1312 ETB</p>
                </div>
                <button class="bg-yellow-500 text-black font-bold px-5 py-2 rounded-lg">Play</button>
            </div>

            <div onclick="selectStake(50)" class="bg-indigo-900 hover:bg-indigo-800 p-4 rounded-xl flex justify-between items-center cursor-pointer border border-indigo-700">
                <div>
                    <span class="text-xl font-bold text-yellow-400">50 ETB</span>
                    <p class="text-xs text-gray-400">ዝቅተኛ ቀሪ ሂሳብ</p>
                </div>
                <button class="bg-yellow-500 text-black font-bold px-5 py-2 rounded-lg">Play</button>
            </div>
        </div>

        <!-- Game Board Screen (Hidden initially) -->
        <div id="game-screen" class="hidden space-y-3">
            <div class="flex justify-between text-sm bg-indigo-900 p-2 rounded-lg">
                <span>Game ID: 672</span>
                <span>Players: 84</span>
                <span class="text-green-400 font-bold">Calling...</span>
            </div>

            <!-- Current Call Display -->
            <div class="bg-indigo-900 p-4 rounded-xl text-center border-2 border-yellow-500">
                <p class="text-xs text-gray-300">Current Call</p>
                <h1 id="current-number" class="text-4xl font-black text-yellow-400 my-1">G-58</h1>
            </div>

            <!-- Bingo Board (5x5 Grid) -->
            <div class="bg-white text-black p-3 rounded-xl shadow-xl">
                <div class="grid grid-cols-5 gap-1 text-center font-bold text-indigo-900 mb-2">
                    <div>B</div><div>I</div><div>N</div><div>G</div><div>O</div>
                </div>
                <div id="board-grid" class="grid grid-cols-5 gap-1 text-center font-semibold"></div>
                <p class="text-center text-xs mt-2 text-gray-600">Board No. 27</p>
            </div>

            <!-- Bingo Action Button -->
            <button onclick="claimBingo()" class="w-full bg-red-600 hover:bg-red-700 text-white font-black text-2xl py-3 rounded-xl shadow-lg uppercase tracking-widest animate-pulse">
                BINGO!
            </button>
        </div>

        <div class="text-center text-xs text-gray-500 mt-4">
            Arada Bingo 2026
        </div>
    </div>

    <script>
        function selectStake(amount) {
            document.getElementById('stake-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
            generateBoardNumbers();
        }

        function generateBoardNumbers() {
            const grid = document.getElementById('board-grid');
            grid.innerHTML = '';
            const sampleNumbers = [11, 26, 39, 51, 75, 3, 28, 33, 56, 67, 10, 24, '*', 58, 74, 7, 18, 45, 53, 69, 13, 30, 44, 47, 64];
            
            sampleNumbers.forEach((num) => {
                const cell = document.createElement('div');
                cell.className = "p-2 bg-gray-200 rounded flex items-center justify-center text-sm font-bold cursor-pointer transition";
                cell.innerText = num;
                if(num === '*') {
                    cell.className += " bg-yellow-400 text-white";
                }
                cell.onclick = function() {
                    cell.classList.toggle('bg-green-500');
                    cell.classList.toggle('text-white');
                };
                grid.appendChild(cell);
            });
        }

        function claimBingo() {
            alert('ቢንጎዎ ተረጋግጧል! ሽልማቱ ወደ ቦርሳዎ ገቢ ተደርጓል 🎉');
        }
    </script>
</body>
</html>
